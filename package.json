{
  "name": "aivest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm install --prefix frontend && npm install --prefix backend/services/api-node",
    "setup:python": "pip install -r backend/services/api-python/requirements.txt",
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:native": "npm run dev --prefix frontend",
    "dev:api-python": "npm run start --prefix backend/services/api-python",
    "dev:api-node": "npm run start --prefix backend/services/api-node",
    "dev:backends": "concurrently -n python,node -c green,magenta \"npm run dev:api-python\" \"npm run dev:api-node\"",
    "dev:all:native": "concurrently -n web,python,node -c blue,green,magenta \"npm run dev:native\" \"npm run dev:api-python\" \"npm run dev:api-node\"",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "validate": "npm run validate --prefix frontend",
    "test": "npm run validate",
    "docker:test": "docker compose --profile test run --rm --build test",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "github:setup-labels": "bash .github/scripts/setup-github-labels.sh",
    "github:setup-milestone": "bash .github/scripts/setup-github-milestone.sh",
    "github:setup": "bash .github/scripts/setup-all.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
