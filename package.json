{
  "name": "aivest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "validate": "npm run validate --prefix frontend",
    "docker:up": "docker compose -f backend/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f backend/docker-compose.yml down",
    "docker:logs": "docker compose -f backend/docker-compose.yml logs -f",
    "github:setup-labels": "bash .github/scripts/setup-github-labels.sh",
    "github:setup-milestone": "bash .github/scripts/setup-github-milestone.sh",
    "github:setup": "bash .github/scripts/setup-all.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
