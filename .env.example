# Copy to frontend/.env.local for Next.js (never commit secrets).

# Primary API (FastAPI) — local Docker backend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_GO_URL=http://localhost:8080
NEXT_PUBLIC_API_NODE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Docker backend or Neon in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivest

# Clerk (when auth is added)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
