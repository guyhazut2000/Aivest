# Dev defaults (read by docker compose via shell env, or copy to .env)

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_NODE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Postgres (local Docker — see docker-compose.yml postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aivest

# Optional — enables LLM narrative in Python portfolio analysis
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
